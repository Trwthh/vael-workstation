{
  "name": "vael-workstation",
  "version": "0.1.4",
  "description": "VAEL — Advanced Autonomous AI Engineering Workstation",
  "author": "VAEL <https://github.com/TRW-HUB>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TRW-HUB/vael-workstation"
  },
  "homepage": "https://github.com/TRW-HUB/vael-workstation",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node --test tests/agents.test.mts",
    "test:live": "node tests/agent.live.mjs",
    "package": "pnpm run build && electron-builder --win nsis && powershell -ExecutionPolicy Bypass -File installer/build.ps1 && node -e \"const{readdirSync,cpSync}=require('fs'),{join}=require('path'),d='release';for(const f of readdirSync(d)){if(!f.endsWith('.exe')||f.includes('blockmap'))continue;cpSync(join(d,f),f.includes('Setup')?'VAEL-Workstation-Setup.exe':'VAEL-Workstation.exe');console.log('Copied',f,'to root')}\"",
    "package:portable": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "better-sqlite3": "^11.6.0",
    "electron-updater": "^6.8.11",
    "framer-motion": "^11.11.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.vael.workstation",
    "productName": "VAEL Workstation",
    "copyright": "Copyright © 2026 VAEL",
    "directories": {
      "output": "release"
    },
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!**/*.map",
      "!**/node_modules/**/*.md",
      "!**/node_modules/**/*.d.ts",
      "!**/node_modules/**/test/**",
      "!**/node_modules/**/tests/**",
      "!**/node_modules/**/__tests__/**",
      "!**/node_modules/**/docs/**",
      "!**/*.db",
      "!**/*.db-journal",
      "!**/*.db-wal",
      "!**/data/vael.db*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon-valid.ico",
      "artifactName": "VAEL-Workstation-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VAEL Workstation",
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": true,
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "VAEL-Workstation-${version}-Portable.${ext}"
    },
    "publish": {
      "provider": "generic",
      "url": "https://updates.trwhub.com/vael-workstation",
      "channel": "latest",
      "updaterCacheDirName": "vael-workstation-updater"
    }
  }
}
